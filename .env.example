# ─── Site ────────────────────────────────────────────────────────
# Must be the real, public URL. M-Pesa callbacks and share cards are
# built from this, so a wrong value breaks both.
NEXT_PUBLIC_SITE_URL=https://siranthony.online

# ─── Sanity ──────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Read-only token, used for rendering the site
SANITY_API_TOKEN=

# WRITE token — required for the store. Purchases are recorded as Sanity
# documents, so without this nobody can buy anything.
# Create at sanity.io/manage → API → Tokens, with Editor permissions.
SANITY_API_WRITE_TOKEN=

# Secret used to HMAC buyers' access tokens before storing them.
# Any long random string. Changing it invalidates every existing
# download link, so set it once and leave it alone.
# Generate with:  openssl rand -base64 32
ACCESS_TOKEN_SECRET=

# Shared secret for the Sanity webhook that triggers revalidation
SANITY_WEBHOOK_SECRET=

# ─── M-Pesa (Safaricom Daraja) ───────────────────────────────────
# From developer.safaricom.co.ke → your app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# 'sandbox' while testing, 'production' when live
MPESA_ENV=sandbox

# Your Paybill or Till number. Sandbox test shortcode is 174379.
MPESA_SHORTCODE=174379

# 'paybill' (default) or 'till' — controls the transaction type sent to Daraja
MPESA_SHORTCODE_TYPE=paybill

# Lipa Na M-Pesa Online passkey
MPESA_PASSKEY=

# REQUIRED IN PRODUCTION. A random string that becomes part of the callback
# path, so the endpoint cannot be guessed and posted to. Without it anyone who
# finds the URL can attempt a forged payment notification.
# Generate with:  openssl rand -hex 16
MPESA_CALLBACK_SECRET=

# Reject callbacks that do not come from Safaricom's published ranges
# (196.201.212.0/24, 196.201.213.0/24, 196.201.214.0/24).
# Left off by default: Safaricom adds addresses without notice, and a stale
# allowlist silently rejecting real payments is worse than the other two
# defences. Turn it on once live and watch the logs.
MPESA_VERIFY_CALLBACK_IP=false

# Comma-separated extra IPs or CIDRs to allow, if Safaricom adds one
MPESA_EXTRA_CALLBACK_IPS=

# Optional. Overrides the whole callback URL, secret path included.
# Safaricom cannot reach localhost — use an ngrok/cloudflared URL when
# testing locally, or rely on the status poll, which works without it.
MPESA_CALLBACK_URL=

# ─── Downloads ───────────────────────────────────────────────────
# Files larger than this are streamed through unstamped rather than buffered
# for watermarking, which would exhaust the function's memory. Bytes.
MAX_WATERMARK_BYTES=25165824

# Hard ceiling on what will be served at all. Bytes.
MAX_DOWNLOAD_BYTES=209715200

# ─── Email (optional) ────────────────────────────────────────────
# Used to send buyers their access link. If unset, the link is still
# shown on screen the moment payment lands; only the email is skipped.
RESEND_API_KEY=
EMAIL_FROM="Sir Anthony <hello@siranthony.online>"
CONTACT_EMAIL=

# ─── Sanity Studio protection (production) ───────────────────────
STUDIO_USERNAME=admin
STUDIO_PASSWORD=
