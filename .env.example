# ===========================================
# Sanity Configuration
# ===========================================

# Sanity Project ID (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id

# Sanity Dataset (defaults to 'production')
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Version (defaults to '2024-01-01')
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ===========================================
# Sanity API Tokens (for server-side operations)
# ===========================================

# Sanity API Token with write permissions (for revalidation)
# Generate this token in Sanity Studio: Manage > API > Tokens
SANITY_API_TOKEN=your-sanity-api-token

# ===========================================
# Webhook Configuration
# ===========================================

# Secret key for verifying webhook requests from Sanity
# This should match the secret header sent by Sanity webhooks
# Generate a random string for this value
SANITY_WEBHOOK_SECRET=your-webhook-secret-key

# ===========================================
# Site Configuration
# ===========================================

# Your production site URL (used for webhook callbacks)
# Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ===========================================
# Setup Instructions
# ===========================================
# 
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in your Sanity project credentials
#
# 3. Generate a SANITY_API_TOKEN:
#    - Go to sanity.io/manage
#    - Select your project
#    - Go to API > Tokens
#    - Click "Add API token"
#    - Give it a name and set permissions to "Editor" or higher
#    - Copy the token and paste it here
#
# 4. Set up SANITY_WEBHOOK_SECRET:
#    - Generate a random string (e.g., using: openssl rand -hex 32)
#    - Use the same value when creating webhooks in Sanity
#
# 5. Set NEXT_PUBLIC_SITE_URL to your production domain
#
# 6. Deploy webhooks to Sanity:
#    - Go to sanity.io/manage
#    - Select your project
#    - Go to API > Webhooks
#    - Click "Add webhook"
#    - Configure it to trigger on: publishDocument, deleteDocument, updateDocument
#    - Set URL to: https://your-domain.com/api/revalidate
#    - Add header: X-Sanity-Secret with your SANITY_WEBHOOK_SECRET value
#
# ===========================================